# Server-side email settings only. Replace placeholders in the host's secret store or local .env.
# Never commit a populated .env file or place credentials in frontend code.
BRAND_NAME="KAI MORI"
CONTACT_INBOX=your-inbox@example.com
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=replace-with-provider-secret
SMTP_USE_STARTTLS=true
